# API keys and secrets for tools/ scripts. Copy this file to .env and fill
# in real values. .env is gitignored -- never commit real secrets.

# Tavily Search API (free tier: 1,000 credits/month, no credit card)
# Used by tools/research_topic.py -- get a key at https://tavily.com
TAVILY_API_KEY=

# tools/make_infographics.py (Pollinations.ai) needs no API key.
#
# Gmail sending (tools/send_newsletter_email.py) does NOT use a .env key
# either -- it authenticates via credentials.json + token.json (Google
# OAuth) in the project root instead. See README.md for setup.
